  "corrections": [
    {
      "on": "Green Pepper",
      "says": "Green Pepper / Flavor: Fresh, citrusy, mild / Use: Salads, vegetables, fish",
      "should": "The card shows green peppercorns, the unripe berry of the black pepper vine sold brined or freeze dried, so it should be named Green Peppercorn; in an American kitchen green pepper means a green bell pepper.",
      "why": "The picture is a bowl of small round green berries beside black and white peppercorns, and the app's Black Pepper and the Pepper Family entry defines green pepper as the unripe berry, fresh and bright, used in steak au poivre vert."
    },
    {
      "on": "Paprika",
      "says": "Flavor: Sweet, smoky, mild",
      "should": "Plain paprika is sweet, fruity and mild but not smoky; only Spanish smoked paprika (pimenton de la Vera) tastes of smoke, so the card should say sweet, fruity, mild or name the smoked kind.",
      "why": "Sweet and Hungarian paprika are air dried ground red peppers with no smoke flavor, and the app's Paprika and Pimenton entry keeps the oak smoked Spanish style separate from the bright, fruity Hungarian kind."
    },
    {
      "on": "Sweet Basil",
      "says": "Sweet Basil / Flavor: Sweet, spicy, fresh / Use: Italian, pasta, salads",
      "should": "Sweet basil is the same herb as the Basil card in row 3 (Ocimum basilicum, the common Genovese basil), so the plate lists one herb twice under two names; keep one basil card, or make the second card Thai basil, a different anise scented plant.",
      "why": "Sweet basil is the standard trade and botanical name for ordinary culinary basil, both cards draw the same broad green leaf and give nearly the same uses, and the app's Thai Basil entry uses sweet basil as the plain name for Genovese basil."
    },
    {
      "on": "Anise",
      "says": "Anise, drawn as eight pointed star shaped pods",
      "should": "The picture is star anise, the pod of the Asian tree Illicium verum, a different plant from anise seed; name the card Star Anise, or keep the name Anise and draw the small oval seed of Pimpinella anisum.",
      "why": "Anise seed is the small gray green Mediterranean seed of pastis, ouzo and pizzelle while star anise is the eight pointed pod of pho, red braised pork and five spice, and the app keeps them as two separate Lexicon entries that share anethole but not personality."
    },
    {
      "on": "Harissa",
      "says": "Harissa, drawn as a red paste in a bowl, among the dry spices",
      "should": "Harissa is a Tunisian chili paste of dried chilies pounded with garlic, salt and toasted spices and kept under olive oil, a condiment rather than a dry spice; if a dry blend is meant, call it harissa spice blend.",
      "why": "The card draws a wet red paste, and the app's Lexicon and Floor Deck both file harissa as a Tunisian red paste of dried chilies, garlic and toasted caraway, coriander and cumin finished under oil."
    }
  ]
