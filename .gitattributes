# The archived original is ground truth. Never let git rewrite its line endings —
# byte-identity with the source is what the extraction parity tests depend on.
reference/world-table-v1.html -text

# Committed data artifacts: keep LF so diffs stay readable across machines.
*.json text eol=lf
*.mjs  text eol=lf
*.ts   text eol=lf
*.js   text eol=lf
*.svelte text eol=lf
*.css  text eol=lf
*.md   text eol=lf
# The workflow carries a multi-line bash block (the re-derive gate). A CRLF
# checkout of it fails on an ubuntu runner with an error that names the shell,
# not the line endings. This held only because core.autocrlf normalises on
# commit here; the attribute makes it true on any machine.
*.yml  text eol=lf
