{
	"name": "world-table",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node tools/postbuild.mjs",
		"preview": "node tools/serve.mjs 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"extract": "node tools/extract.mjs",
		"verify:data": "node tools/verify-extraction.mjs",
		"build:data": "node tools/build-data.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"verify:build": "node tools/verify-build.mjs",
		"verify:derived": "node tools/build-data.mjs && git diff --exit-code -- src/lib/data tools/derive",
		"icons": "node tools/make-icons.mjs",
		"build:quick": "node tools/build-quick.mjs",
		"test:e2e": "playwright test",
		"preview:vite": "vite preview",
		"report:notes": "node tools/report-notes.mjs",
		"report:tech": "node tools/report-techniques.mjs",
		"build:pages": "node tools/build-pages.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^26.2.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/browser": "^4.1.10",
		"acorn": "^8.18.0",
		"acorn-walk": "^8.3.5",
		"playwright": "^1.62.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.10"
	},
	"description": "The World Table: an interactive culinary field guide",
	"dependencies": {
		"@fontsource/cormorant-garamond": "^5.3.0",
		"@fontsource/eb-garamond": "^5.3.0",
		"idb-keyval": "^6.3.0",
		"minisearch": "^7.2.0"
	}
}
